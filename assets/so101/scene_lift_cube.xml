<mujoco model="so101_lift_cube">
  <include file="so101_new_calib.xml"/>
  <option timestep="0.0033333333" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".15 .15 .15" rgb2=".2 .2 .2"
             width="512" height="512"/>
    <material name="mat_table" texture="grid" texrepeat="4 4" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.3 -0.3 1.0" dir="-0.3 0.3 -1" diffuse="0.8 0.8 0.8"/>
    <light name="fill" pos="-0.3 -0.3 0.8" dir="0.3 0.3 -1" diffuse="0.3 0.3 0.3"/>
    <geom name="table" type="plane" size="0.5 0.5 0.01" material="mat_table" friction="1 0.005 0.0001"/>
    <camera name="top" pos="0 -0.45 0.45" xyaxes="1 0 0  0 0.7 0.7" fovy="55"/>

    <body name="cube" pos="0.15 0.15 0.015">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.015 0.015 0.015" mass="0.03"
            rgba="0.85 0.2 0.2 1" friction="1.2 0.01 0.0001"/>
    </body>
  </worldbody>
</mujoco>
